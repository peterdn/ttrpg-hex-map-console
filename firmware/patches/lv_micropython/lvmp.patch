diff --git a/drivers/bus/spi.h b/drivers/bus/spi.h
index df7f790df..5157dde70 100644
--- a/drivers/bus/spi.h
+++ b/drivers/bus/spi.h
@@ -38,6 +38,11 @@ typedef struct _mp_spi_proto_t {
