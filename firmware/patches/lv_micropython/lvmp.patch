 } mp_spi_proto_t;
 
+enum {
+    MP_SOFT_SPI_FLAG_MOSI_ENABLED = 0x1,
+    MP_SOFT_SPI_FLAG_MISO_ENABLED = 0x2,
+};
+
 typedef struct _mp_soft_spi_obj_t {
